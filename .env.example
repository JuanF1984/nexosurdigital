# Resend (https://resend.com) - used to send alert emails from /api/energy-event
RESEND_API_KEY=

# Shared secret the ESP32 device must send as: Authorization: Bearer <DEVICE_API_KEY>
DEVICE_API_KEY=

# Sender address used for alert emails. Must be a verified domain/sender in Resend.
ALERT_EMAIL_FROM=

# Recipient(s) for alert emails. Comma-separated if more than one address.
ALERT_EMAIL_TO=

# --- MIDE platform (/api/mide/*) — independent of the variables above ---

# Supabase project URL, used only by the server-side /api/mide/* routes.
SUPABASE_URL=

# Supabase service role ("secret") key. Server-only, never exposed to the
# client, never logged, never returned in a response.
SUPABASE_SECRET_KEY=

# Shared secret MIDE devices send as: Authorization: Bearer <MIDE_DEVICE_API_KEY>
# Interim auth (see docs/mide/seguridad.md for the planned per-device HMAC).
MIDE_DEVICE_API_KEY=

# --- Turnos platform — UNUSED since the dashboard/login migration + legacy
# code removal (see docs/turnos/estado-proyecto.md). No file in this repo
# reads any of the five variables below anymore (verified by grep across
# src/ before removing the code that used them) — /turnos/login and
# /turnos/dashboard now live entirely in turnos-web
# (turnos.nexosurdigital.com.ar), and the old /turnos/* paths here are pure
# redirects (next.config.ts), not pages that need configuration.
#
# Left here (not deleted from this file, and NOT removed from Vercel)
# because that's an explicit follow-up decision, not part of this cleanup —
# see "Pendiente" in docs/turnos/estado-proyecto.md. Safe to fully retire
# from both `.env.local`/`.env.example` and the Vercel project whenever
# that decision is made; nothing in this codebase depends on them anymore.
TURNOS_SUPABASE_URL=
TURNOS_SUPABASE_ANON_KEY=
TURNOS_SUPABASE_SECRET_KEY=
TURNOS_API_URL=
TURNOS_API_TOKEN=

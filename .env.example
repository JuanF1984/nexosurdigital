# Resend (https://resend.com) - used to send alert emails from /api/energy-event
RESEND_API_KEY=

# Shared secret the ESP32 device must send as: Authorization: Bearer <DEVICE_API_KEY>
DEVICE_API_KEY=

# Sender address used for alert emails. Must be a verified domain/sender in Resend.
ALERT_EMAIL_FROM=

# Recipient(s) for alert emails. Comma-separated if more than one address.
ALERT_EMAIL_TO=

# --- MIDE platform (/api/mide/*) — independent of the variables above ---

# Supabase project URL, used only by the server-side /api/mide/* routes.
SUPABASE_URL=

# Supabase service role ("secret") key. Server-only, never exposed to the
# client, never logged, never returned in a response.
SUPABASE_SECRET_KEY=

# Shared secret MIDE devices send as: Authorization: Bearer <MIDE_DEVICE_API_KEY>
# Interim auth (see docs/mide/seguridad.md for the planned per-device HMAC).
MIDE_DEVICE_API_KEY=

# --- Turnos platform (/turnos/dashboard) — its own Supabase project, fully
# independent of MIDE (above) and of the WhatsApp bot in the separate
# Proyectos/whatsapp-demo project. Never reuse the MIDE variables above for
# Turnos, and never point these at MIDE's Supabase project. ---

# Supabase Turnos project URL.
TURNOS_SUPABASE_URL=

# Supabase Turnos anon/publishable key. Used only by the server-side auth
# client (src/lib/turnos/supabase-auth.ts) for sign-in/session — never
# bundled to the browser (no NEXT_PUBLIC_ prefix, no client-side Supabase
# usage in this module).
TURNOS_SUPABASE_ANON_KEY=

# Supabase Turnos service role ("secret") key. Server-only, bypasses RLS,
# used for all business-data reads (turnos/comercios/servicios/recursos).
# Never exposed to the client, never logged, never returned in a response.
TURNOS_SUPABASE_SECRET_KEY=

# --- Turnos cancellation (nexosur-turnos backend, a separate project) —
# consumed only from src/lib/turnos/cancellation.ts, server-only, never
# reused for anything else. See docs/turnos/cancelacion.md. ---

# Base URL of the nexosur-turnos backend (e.g. its Vercel deployment URL).
# POST /api/turnos/cancelar is called against this URL.
TURNOS_API_URL=

# Shared secret sent as: Authorization: Bearer <TURNOS_API_TOKEN>. This
# authenticates nexosur-web as a trusted backend caller to nexosur-turnos —
# it does NOT represent the dashboard user's authorization, which is
# resolved separately in nexosur-web via usuario_comercios before this call
# is ever made. Never exposed to the client, never logged.
TURNOS_API_TOKEN=

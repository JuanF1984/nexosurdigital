# Resend (https://resend.com) - used to send alert emails from /api/energy-event
RESEND_API_KEY=

# Shared secret the ESP32 device must send as: Authorization: Bearer <DEVICE_API_KEY>
DEVICE_API_KEY=

# Sender address used for alert emails. Must be a verified domain/sender in Resend.
ALERT_EMAIL_FROM=

# Recipient(s) for alert emails. Comma-separated if more than one address.
ALERT_EMAIL_TO=

# --- MIDE platform (/api/mide/*) — independent of the variables above ---

# Supabase project URL, used only by the server-side /api/mide/* routes.
SUPABASE_URL=

# Supabase service role ("secret") key. Server-only, never exposed to the
# client, never logged, never returned in a response.
SUPABASE_SECRET_KEY=

# Shared secret MIDE devices send as: Authorization: Bearer <MIDE_DEVICE_API_KEY>
# Interim auth (see docs/mide/seguridad.md for the planned per-device HMAC).
MIDE_DEVICE_API_KEY=
